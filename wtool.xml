<?xml version="1.0" encoding="UTF-8"?>
<!--
  迁移自 mytool/fzf（原 wsw-fzf-static）—— fzf 二进制 + 补全脚本。

  演示"多 shell"：zsh 与 bash 各有一份 env，框架会分别注入 ~/.zshrc 与 ~/.bashrc。
  priority=60，在 tools/repo(40) / terminal/tmux(50) 之后加载。
-->
<wtool schema="1" id="terminal/fzf" priority="60">

  <zshrc  src="env.zsh"  priority="60"/>
  <bashrc src="env.bash" priority="60"/>

</wtool>
